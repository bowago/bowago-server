generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

// Top-level "which world does this user belong to" switch.
// CUSTOMER    → Customer System (end user, no company)
// ADMIN       → Internal BowaGo Administration (platform staff)
// ENTERPRISE  → Enterprise System (BowaGo-as-a-Service tenant user)
enum UserRole {
  CUSTOMER
  ADMIN
  ENTERPRISE
}

// Internal BowaGo staff roles ONLY. Never used for Enterprise tenants.
// Governs access to platform-wide business operations (rates, zones,
// pricing, enterprise management, platform settings, etc).
enum AdminSubRole {
  SUPER_ADMIN           // Full system access — creates custom admin roles
  LOGISTICS_MANAGER     // Legacy: maps to ROLE_ADMIN in PRD v2 — kept for FE compat
  ROLE_ADMIN            // Custom role given by SUPER_ADMIN (capabilities set in AdminRolePermission)
}

// Enterprise tenant roles ONLY. Scoped entirely to the user's own company
// (via masterId). Never grants access to platform administration.
enum EnterpriseRole {
  ROLE_MASTER           // Company owner/admin: invite/remove users, assign roles, manage company
  ROLE_AGENT            // Company CS rep: customer-related workflows only
  ROLE_DISPATCHER       // Company shipment ops: create/book/update/track shipments
  ROLE_FINANCE          // Company finance: invoices, payments, financial reports
  ROLE_USER             // Standard company user: quotes, shipments, tracking, own invoices
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum ShipmentStatus {
  PENDING
  BOOKED
  AWAITING_PICKUP
  CONFIRMED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
  RETURNED
  PENDING_ADMIN_REVIEW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentChannel {
  CARD
  BANK_TRANSFER
  USSD
  MOBILE_MONEY
  QR
}

enum WeightUnit {
  KG
  TONS
  CARTONS
}

enum NotificationType {
  SHIPMENT_UPDATE
  PAYMENT
  PROMO
  SYSTEM
  DELAY_ALERT
  PRICE_ADJUSTMENT
}

enum ServiceType {
  EXPRESS
  STANDARD
  ECONOMY
}


enum QuoteStatus {
  GENERATED
  EXPIRED
  BOOKED
  CANCELLED
}

enum ConsentType {
  TERMS_OF_SERVICE
  REFUND_POLICY
  SHIPPING_RULES
  INSURANCE_TERMS
}

enum SurchargeType {
  FUEL
  REMOTE_AREA
  VAT
  FRAGILE
  INSURANCE
  OVERSIZE
}

enum AddressChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ESCALATED
}

enum TicketCategory {
  TRACKING
  PAYMENT
  PRICING_DISPUTE
  DAMAGED_GOODS
  DELIVERY_ISSUE
  ACCOUNT
  OTHER
}

enum FaqCategory {
  PRICING
  SHIPPING_RULES
  TRACKING
  PAYMENTS
  ACCOUNT
  PACKAGING
  CLAIMS
  OTHER
}

// ─── USER ────────────────────────────────────────────────────────────────────

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  phone            String?       @unique
  firstName        String
  lastName         String
  avatar           String?
  avatarPublicId   String?
  role             UserRole      @default(CUSTOMER)
  adminSubRole     AdminSubRole?     // set ONLY when role = ADMIN
  enterpriseRole   EnterpriseRole?  // set ONLY when role = ENTERPRISE
  authProvider     AuthProvider  @default(EMAIL)
  googleId         String?       @unique
  appleId          String?       @unique
  passwordHash     String?
  isEmailVerified  Boolean       @default(false)
  isPhoneVerified  Boolean       @default(false)
  isActive         Boolean       @default(true)
  fcmToken         String?
  twoFactorEnabled Boolean @default(false)
  twoFactorMethod  String? // "EMAIL" | "SMS"

  // ─── Company Info (Settings → Company Info tab) ──────────────────────────
  companyName      String?
  industry         String?
  companyEmail     String?
  companyPhone     String?
  companyWebsite   String?
  companyStreet    String?
  companyCity      String?
  companyState     String?
  companyCountry   String?
  companyZip       String?

  // ─── Enterprise org membership (Sprint 8 team feature) ───────────────────
  // Set when a team member accepts an org invite. Points to the ENTERPRISE
  // user with enterpriseRole = ROLE_MASTER who owns the org. Used to scope
  // shipments, invoices, etc. to the tenant. Only meaningful when
  // role = ENTERPRISE.
  masterId         String?   // FK → User.id of the ROLE_MASTER who owns the org

  addresses           Address[]
  savedCards          SavedCard[]
  shipments           Shipment[]           @relation("CustomerShipments")
  managedShipments    Shipment[]           @relation("AssignedShipments")
  otpCodes            OtpCode[]
  refreshTokens       RefreshToken[]
  notifications       Notification[]
  activityLogs        ActivityLog[]
  payments            Payment[]
  addressChangeReqs   AddressChangeRequest[]
  claims              Claim[]
  supportTickets      SupportTicket[]      @relation("TicketCustomer")
  assignedTickets     SupportTicket[]      @relation("TicketAgent")
  rolePermission      AdminRolePermission? @relation("UserRolePermission")
  createdRolePerms    AdminRolePermission[] @relation("RolePermissionCreator")
  quotes              Quote[]              @relation("UserQuotes")
  consentLogs         ConsentLog[]         @relation("UserConsents")
  priceAuditLogs      PriceAuditLog[]
  contractRate       ContractRate?
  promoRedemptions   PromoRedemption[]
  loyaltyAccount     LoyaltyAccount?   @relation("UserLoyalty")

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("users")
}

model Address {
  id          String    @id @default(uuid())
  userId      String
  label       String?
  street      String
  city        String
  state       String
  lga         String?
  postalCode  String?
  country     String    @default("Nigeria")
  lat         Float?
  lng         Float?
  isDefault   Boolean   @default(false)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("addresses")
}

// ─── AUTH ─────────────────────────────────────────────────────────────────────

model OtpCode {
  id        String    @id @default(uuid())
  userId    String
  code      String
  type      String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())

  @@map("otp_codes")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceInfo String?
  ipAddress  String?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())

  @@map("refresh_tokens")
}

// ─── PRICING ─────────────────────────────────────────────────────────────────

model City {
  id        String    @id @default(uuid())
  name      String    @unique
  region    String
  state     String

  fromZones ZoneMatrix[] @relation("FromCity")
  toZones   ZoneMatrix[] @relation("ToCity")
  fromKm    KmMatrix[]   @relation("FromCityKm")
  toKm      KmMatrix[]   @relation("ToCityKm")
  shipmentsFrom Shipment[] @relation("ShipmentFromCity")
  shipmentsTo   Shipment[] @relation("ShipmentToCity")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("cities")
}

model BoxDimension {
  id              String    @id @default(uuid())
  categoryId      String    @unique
  displayName     String
  lengthCm        Float
  widthCm         Float
  heightCm        Float
  bestFor         String?
  weightKgLimit   Float

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("box_dimensions")
}

model ZoneMatrix {
  id          String    @id @default(uuid())
  fromCityId  String
  toCityId    String
  zone        Int
  isActive    Boolean   @default(true)

  fromCity    City      @relation("FromCity", fields: [fromCityId], references: [id])
  toCity      City      @relation("ToCity", fields: [toCityId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([fromCityId, toCityId])
  @@map("zone_matrix")
}

model KmMatrix {
  id          String    @id @default(uuid())
  fromCityId  String
  toCityId    String
  distanceKm  Float

  fromCity    City      @relation("FromCityKm", fields: [fromCityId], references: [id])
  toCity      City      @relation("ToCityKm", fields: [toCityId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([fromCityId, toCityId])
  @@map("km_matrix")
}

model PriceBand {
  id                     String      @id @default(uuid())
  label                  String?
  // Pricing mode A: single zone (legacy / granular)
  zone                   Int?
  pricePerKg             Float?
  basePrice              Float?
  // Pricing mode B: fixed price map across all zones (e.g. {"1":150,"2":200,"3":300,"4":400})
  fixedPricePerKgByZone  Json?
  // Weight / volume range
  minKg                  Float       @default(0)
  maxKg                  Float?
  minTons                Float       @default(0)
  maxTons                Float?
  minCartons             Int         @default(0)
  maxCartons             Int?
  // Discount (optional — mutually exclusive with fixed price fields)
  discountPercent        Float?
  serviceType            ServiceType @default(STANDARD)
  validFrom              DateTime?
  validUntil             DateTime?
  notes                  String?
  isActive               Boolean     @default(true)
  createdBy              String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("price_bands")
}

model Surcharge {
  id          String        @id @default(uuid())
  type        SurchargeType
  label       String
  description String?
  ratePercent Float?
  flatAmount  Float?
  isActive    Boolean       @default(true)
  appliesTo   String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("surcharges")
}

model PriceAuditLog {
  id            String    @id @default(uuid())
  entityType    String
  entityId      String
  action        String
  previousValue Json?
  newValue      Json?
  changedBy     String
  reason        String?

  user          User      @relation(fields: [changedBy], references: [id])

  createdAt     DateTime  @default(now())

  @@map("price_audit_logs")
}

// ─── SHIPMENT ─────────────────────────────────────────────────────────────────

model Shipment {
  id               String         @id @default(uuid())
  trackingNumber   String         @unique
  customerId       String
  assignedToId     String?

  senderName       String
  senderPhone      String
  senderAddress    String
  senderCity       String
  senderState      String

  recipientName    String
  recipientPhone   String
  recipientAddress String
  recipientCity    String
  recipientState   String

  description      String?
  weight           Float
  weightUnit       WeightUnit      @default(KG)
  cartons          Int?
  boxDimensionId   String?
  customLength     Float?
  customWidth      Float?
  customHeight     Float?

  serviceType      ServiceType     @default(STANDARD)
  fromCityId       String?
  toCityId         String?
  fromCity         City?           @relation("ShipmentFromCity", fields: [fromCityId], references: [id])
  toCity           City?           @relation("ShipmentToCity",   fields: [toCityId],   references: [id])
  zone             Int?
  distanceKm       Float?
  quotedPrice      Float
  finalPrice       Float?
  currency         String          @default("NGN")
  surchargeBreakdown Json?

  status           ShipmentStatus  @default(PENDING)
  paymentStatus    PaymentStatus   @default(PENDING)
  cutoffWarning    Boolean         @default(false)

  pickupDate        DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?

  isFragile        Boolean         @default(false)
  requiresInsurance Boolean        @default(false)
  insuranceValue   Float?
  notes            String?

  customer         User            @relation("CustomerShipments", fields: [customerId], references: [id])
  assignedTo       User?           @relation("AssignedShipments", fields: [assignedToId], references: [id])
  trackingHistory  TrackingEvent[]
  documents        ShipmentDocument[]
  payments         Payment[]
  addressChangeReqs AddressChangeRequest[]
  claims           Claim[]
  priceAdjustments PriceAdjustment[]
  quote            Quote?
  // FIX: SupportTicket.shipmentId had no relation back to Shipment, so
  // admin/customer ticket views could never resolve a tracking number —
  // they only ever had the raw shipmentId. Added so listTickets/getTicket
  // can `include: { shipment: { select: { trackingNumber: true } } }`.
  supportTickets   SupportTicket[]
  delayAlert       DelayAlert?

  pickupLat           Float?
  pickupLng           Float?
  proximityAlertSent  Boolean  @default(false)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("shipments")
}

model TrackingEvent {
  id          String    @id @default(uuid())
  shipmentId  String
  status      ShipmentStatus
  location    String?
  description String
  lat         Float?
  lng         Float?
  updatedBy   String?
  proofUrl    String?

  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@map("tracking_events")
}

model ShipmentDocument {
  id           String   @id @default(uuid())
  shipmentId   String
  type         String
  url          String
  publicId     String
  uploadedBy   String?

  shipment     Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@map("shipment_documents")
}

model AddressChangeRequest {
  id                  String              @id @default(uuid())
  shipmentId          String
  userId              String
  newRecipientAddress String
  newRecipientCity    String
  newRecipientState   String
  reason              String?
  status              AddressChangeStatus @default(PENDING)
  reviewedBy          String?
  reviewedAt          DateTime?
  reviewNote          String?

  shipment            Shipment            @relation(fields: [shipmentId], references: [id])
  user                User                @relation(fields: [userId], references: [id])

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("address_change_requests")
}

model PriceAdjustment {
  id              String    @id @default(uuid())
  shipmentId      String
  originalPrice   Float
  adjustedPrice   Float
  difference      Float
  reason          String
  actualWeightKg  Float?
  // Legacy single image — kept for backward compatibility
  proofImageUrl   String?
  // Multi-image support (up to 5 URLs stored as JSON array)
  proofImageUrls  Json?
  isAcknowledged  Boolean   @default(false)
  acknowledgedAt  DateTime?
  isPaid          Boolean   @default(false)
  paymentRef      String?

  // ── Resolution workflow (PRD: Post-Booking Price Shock Prevention) ─────────
  // status: PENDING | PAID | DOWNGRADED | CANCELLED | EXPIRED
  status          String    @default("PENDING")
  // Shipment status captured at the moment it was paused, so we know what
  // to resume it to once resolved (rather than guessing).
  previousStatus  String?
  // Deadline for the customer to respond. Configurable via AppSettings
  // (price_adjustment.response_window_hours). Past this, the scheduler
  // auto-cancels with a refund.
  responseDeadline DateTime?
  resolvedAt      DateTime?
  // resolutionType: PAY | DOWNGRADE | CANCEL | AUTO_CANCEL
  resolutionType  String?
  refundPercent   Int?
  refundAmount    Float?
  // Support/admin override of the deadline
  extendedBy      String?
  extensionNote   String?

  shipment        Shipment  @relation(fields: [shipmentId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("price_adjustments")
}

model Claim {
  id              String      @id @default(uuid())
  shipmentId      String
  userId          String
  type            String
  description     String
  declaredValue   Float
  claimAmount     Float
  bankName        String?
  accountNumber   String?
  accountName     String?
  status          ClaimStatus @default(SUBMITTED)
  reviewNote      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  approvedAmount  Float?
  paidAt          DateTime?

  images          ClaimImage[]
  shipment        Shipment    @relation(fields: [shipmentId], references: [id])
  user            User        @relation(fields: [userId], references: [id])

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("claims")
}

model ClaimImage {
  id        String   @id @default(uuid())
  claimId   String
  url       String
  publicId  String

  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("claim_images")
}

// ─── PAYMENTS ─────────────────────────────────────────────────────────────────

model SavedCard {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorizationCode String   @unique
  last4             String?
  cardType          String?
  bank              String?
  expMonth          String?
  expYear           String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([userId])
}

model Payment {
  id                String         @id @default(uuid())
  reference         String         @unique
  userId            String
  shipmentId        String?

  amountKobo        Int
  currency          String         @default("NGN")
  channel           PaymentChannel?
  status            PaymentStatus  @default(PENDING)

  paystackId        String?   // Paystack tx ID stored as String (too large for Int32)
  gatewayResponse   String?
  paidAt            DateTime?
  authorizationCode String?
  cardLast4         String?
  cardBank          String?

  // FIX: these three fields were already being written/read by
  // paystack.service.js (initializePayment) and payment.controller.js
  // (idempotency lookup) but were missing from the schema. Every "Pay"
  // click was crashing with a PrismaClientValidationError ("Unknown
  // argument `authorizationUrl`"), which the global error handler masks
  // as "Something went wrong on our end." — this was the bug behind the
  // screenshot.
  authorizationUrl  String?
  accessCode        String?
  idempotencyKey    String?

  refundedAt        DateTime?
  refundReference   String?
  refundAmountKobo  Int?

  metadata          Json?

  user              User           @relation(fields: [userId], references: [id])
  shipment          Shipment?      @relation(fields: [shipmentId], references: [id])

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("payments")
}

// ─── SUPPORT ──────────────────────────────────────────────────────────────────

model SupportTicket {
  id           String          @id @default(uuid())
  ticketNumber String          @unique
  customerId   String
  assignedToId String?
  category     TicketCategory  @default(OTHER)
  subject      String
  status       TicketStatus    @default(OPEN)
  priority     String          @default("NORMAL")
  shipmentId   String?
  resolvedAt   DateTime?
  closedAt     DateTime?
  csatScore    Int?            // 1–5 customer satisfaction rating (Sprint 6 KPI)

  customer     User            @relation("TicketCustomer", fields: [customerId], references: [id])
  assignedTo   User?           @relation("TicketAgent", fields: [assignedToId], references: [id])
  shipment     Shipment?       @relation(fields: [shipmentId], references: [id])
  messages     TicketMessage[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("support_tickets")
}

model TicketMessage {
  id            String        @id @default(uuid())
  ticketId      String
  senderId      String
  body          String
  isInternal    Boolean       @default(false)
  attachmentUrl String?

  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())

  @@map("ticket_messages")
}

model CannedResponse {
  id        String    @id @default(uuid())
  title     String
  body      String
  category  String?
  isActive  Boolean   @default(true)
  createdBy String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("canned_responses")
}

// ─── FAQ ──────────────────────────────────────────────────────────────────────

model FaqItem {
  id          String      @id @default(uuid())
  question    String
  answer      String
  category    FaqCategory @default(OTHER)
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  isFeatured  Boolean     @default(false)  // max 4 shown on homepage
  createdBy   String?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("faq_items")
}


// ─── DELIVERY SLA ─────────────────────────────────────────────────────────────
// Admin-configurable delivery days per zone × service type.
// Zone 1 = same state (closest), Zone 4 = furthest cross-region.
model DeliverySLA {
  id          String   @id @default(uuid())
  zone        Int
  serviceType String   // EXPRESS | STANDARD | ECONOMY
  minDays     Int
  maxDays     Int
  label       String?  // auto-generated: "1-3 business days"
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([zone, serviceType])
  @@map("delivery_sla")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime         @default(now())

  @@map("notifications")
}

// ─── SYSTEM ───────────────────────────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  metadata   Json?
  ipAddress  String?

  user       User?    @relation(fields: [userId], references: [id])

  createdAt  DateTime @default(now())

  @@map("activity_logs")
}

model AppSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  group     String?
  updatedBy String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("app_settings")
}

model ContractRate {
  id                     String      @id @default(uuid())
  userId                 String      @unique
  label                  String?
  serviceType            ServiceType?
  discountPercent        Float?
  fixedPricePerKgByZone  Json?
  isActive               Boolean     @default(true)
  validFrom              DateTime?
  validUntil             DateTime?
  notes                  String?
  createdBy              String?
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@map("contract_rates")
}

// Sprint 2 — Promo Codes (customer-facing codes e.g. LAUNCH20)
model PromoCode {
  id              String    @id @default(uuid())
  code            String    @unique
  description     String?
  discountPercent Float?
  flatDiscount    Float?
  minOrderAmount  Float?
  maxUses         Int?
  usedCount       Int       @default(0)
  isActive        Boolean   @default(true)
  validFrom       DateTime?
  validUntil      DateTime?
  serviceType     ServiceType?
  createdBy       String?
  redemptions     PromoRedemption[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("promo_codes")
}

model PromoRedemption {
  id              String    @id @default(uuid())
  promoCodeId     String
  userId          String
  shipmentId      String?
  discountApplied Float
  promoCode       PromoCode @relation(fields: [promoCodeId], references: [id])
  user            User      @relation(fields: [userId], references: [id])
  createdAt       DateTime  @default(now())

  @@unique([promoCodeId, userId, shipmentId])
  @@map("promo_redemptions")
}

// Sprint 2 / Story 9.4 — Policy & T&C content
model PolicyContent {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String
  body      String
  isActive  Boolean  @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("policy_content")
}

// Sprint 5 / Story 11.5 — Packaging guide
model PackagingGuide {
  id          String   @id @default(uuid())
  title       String
  body        String
  category    String
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isDangerous Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("packaging_guides")
}

// ─── CUSTOM ADMIN ROLE PERMISSIONS (Sprint 2) ─────────────────────────────────
// SUPER_ADMIN creates custom admin roles with specific capability flags.
// One record per admin user — defines their capabilities.
model AdminRolePermission {
  id               String   @id @default(uuid())
  userId           String   @unique
  // Capability flags — SUPER_ADMIN toggles these per staff member
  canManageRates          Boolean @default(false)
  canManageUsers          Boolean @default(false)
  canManageShipments      Boolean @default(false)
  canViewAnalytics        Boolean @default(false)
  canManageTickets        Boolean @default(false)
  canManageInvoices       Boolean @default(false)
  canManageSurcharges     Boolean @default(false)
  canManagePromos         Boolean @default(false)
  canManageClaims         Boolean @default(false)
  canBulkNotify           Boolean @default(false)
  canViewAuditLogs        Boolean @default(false)
  canManageOrganization   Boolean @default(false)
  // Role label (e.g. "Rate Manager", "CS Lead")
  roleLabel        String?
  notes            String?
  createdBy        String
  updatedBy        String?

  user             User     @relation("UserRolePermission", fields: [userId], references: [id])
  creator          User     @relation("RolePermissionCreator", fields: [createdBy], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("admin_role_permissions")
}

// ─── QUOTE LIFECYCLE (Sprint 1 gap fix) ──────────────────────────────────────
// Quotes are valid for exactly 15 minutes. Immutable once locked.
model Quote {
  id                    String      @id @default(uuid())
  userId                String?     // null = guest quote
  status                QuoteStatus @default(GENERATED)
  // Origin / Destination
  originCity            String
  originCityId          String?
  destinationCity       String
  destinationCityId     String?
  zone                  Int?
  distanceKm            Float?
  // Weight
  weightKg              Float?
  volumetricWeightKg    Float?
  billableWeightKg      Float?
  lengthCm              Float?
  widthCm               Float?
  heightCm              Float?
  // Pricing
  serviceType           ServiceType @default(STANDARD)
  basePriceKobo         Int         // stored in kobo to avoid float errors
  fuelSurchargeKobo     Int         @default(0)
  remoteAreaFeeKobo     Int         @default(0)
  vatKobo               Int         @default(0)
  totalPriceKobo        Int
  // Insurance
  insuranceSelected     Boolean     @default(false)
  declaredValueKobo     Int?
  insurancePremiumKobo  Int?
  // Pricing mode — records which rate path was used at quote time (Gap 6)
  pricingMode           String    @default("STANDARD") // STANDARD | CONTRACT | PROMO
  // Promo
  promoCode             String?
  promoDiscountKobo     Int?
  // Lifecycle timestamps
  expiresAt             DateTime    // createdAt + 15 min
  bookedAt              DateTime?
  cancelledAt           DateTime?
  // Linked shipment (once booked)
  shipmentId            String?     @unique
  shipment              Shipment?   @relation(fields: [shipmentId], references: [id])

  user                  User?       @relation("UserQuotes", fields: [userId], references: [id])

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("quotes")
}

// ─── CONSENT LOG (Sprint 7) ───────────────────────────────────────────────────
// Immutable audit of user consent at quote/payment/booking time.
model ConsentLog {
  id            String      @id @default(uuid())
  userId        String?
  sessionId     String?     // for guest consent
  consentType   ConsentType
  tcVersion     String      // e.g. "v1.2"
  acceptedAt    DateTime    @default(now())
  ipAddress     String?
  userAgent     String?

  user          User?       @relation("UserConsents", fields: [userId], references: [id])

  @@map("consent_logs")
}

model FailedWebhook {
        id            String    @id @default(uuid())
        event         String    // e.g. "charge.success"
        payload       Json      // full original webhook body, for replay
        errorMessage  String?
        attempts      Int       @default(0)
        status        String    @default("FAILED") // FAILED | RESOLVED | IGNORED
        createdAt     DateTime  @default(now())
        lastRetriedAt DateTime?
        resolvedAt    DateTime?

        @@index([status])
        @@index([event])
      }


// ─── LOGIN LOCKOUT (Sprint 2 gap fix) ────────────────────────────────────────
// Track failed login attempts per email for 15-minute lockout after 5 failures.
model LoginAttempt {
  id            String   @id @default(uuid())
  email         String
  failedCount   Int      @default(0)
  lockedUntil   DateTime?
  lastAttemptAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([email])
  @@map("login_attempts")
}

// ─── ORG INVITE (Sprint 8) ────────────────────────────────────────────────────
// Master user invites team members via email. Invite expires in 7 days.
model OrgInvite {
  id          String    @id @default(uuid())
  email       String
  role        String    @default("ROLE_DISPATCHER") // EnterpriseRole string
  invitedBy   String    // User.id of master who sent invite
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  status      String    @default("PENDING") // PENDING | ACCEPTED | EXPIRED | CANCELLED

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@map("org_invites")
}

// ─── LOYALTY & REWARDS (Customer Portal) ─────────────────────────────────────
// Points are earned on paid delivery and redeemed at checkout.
// Tier is recalculated each time points are earned.
//
// Tier thresholds (configurable via AppSettings):
//   BRONZE  0–499 pts   → no multiplier
//   SILVER  500–1999    → 1.25×
//   GOLD    2000–4999   → 1.5×
//   PLATINUM 5000+      → 2×
//
// Earn rate: 1 point per ₦100 of shipment final price (configurable).
// Redeem rate: 1 point = ₦1 discount, min 50 pts per redemption (configurable).

model LoyaltyAccount {
  id              String    @id @default(uuid())
  userId          String    @unique
  points          Int       @default(0)    // current spendable balance
  lifetimePoints  Int       @default(0)    // never decremented — used for tier
  tier            String    @default("BRONZE") // BRONZE | SILVER | GOLD | PLATINUM

  user            User      @relation("UserLoyalty", fields: [userId], references: [id])
  transactions    LoyaltyTransaction[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id          String   @id @default(uuid())
  accountId   String
  type        String   // EARN | REDEEM | ADJUST | EXPIRE
  points      Int      // positive = earn, negative = redeem/expire
  description String
  shipmentId  String?  // source shipment for EARN or REDEEM

  account     LoyaltyAccount @relation(fields: [accountId], references: [id])

  createdAt   DateTime @default(now())
  @@map("loyalty_transactions")
}

// ─── DELAY ALERTS (SLA Breach Detection) ─────────────────────────────────────
// Written by the SLA breach scheduler when a shipment overruns its estimated
// delivery date. Used to avoid spamming the same customer on every sweep.

model DelayAlert {
  id          String   @id @default(uuid())
  shipmentId  String
  alertedAt   DateTime @default(now())
  reason      String?

  shipment    Shipment @relation(fields: [shipmentId], references: [id])

  @@unique([shipmentId])  // one active alert per shipment
  @@map("delay_alerts")
}
