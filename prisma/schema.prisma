generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

// Top-level "which world does this user belong to" switch.
// CUSTOMER    → Customer System (end user, no company)
// ADMIN       → Internal BowaGo Administration (platform staff)
// ENTERPRISE  → Enterprise System (BowaGo-as-a-Service tenant user)
enum UserRole {
  CUSTOMER
  ADMIN
  ENTERPRISE
}

// Internal BowaGo staff roles ONLY. Never used for Enterprise tenants.
// Governs access to platform-wide business operations (rates, zones,
// pricing, enterprise management, platform settings, etc).
enum AdminSubRole {
  SUPER_ADMIN           // Full system access — creates custom admin roles
  LOGISTICS_MANAGER     // Legacy: maps to ROLE_ADMIN in PRD v2 — kept for FE compat
  ROLE_ADMIN            // Custom role given by SUPER_ADMIN (capabilities set in AdminRolePermission)
}

// Enterprise tenant roles ONLY. Scoped entirely to the user's own company
// (via masterId). Never grants access to platform administration.
enum EnterpriseRole {
  ROLE_MASTER           // Company owner/admin: invite/remove users, assign roles, manage company
  ROLE_AGENT            // Company CS rep: customer-related workflows only
  ROLE_DISPATCHER       // Company shipment ops: create/book/update/track shipments
  ROLE_FINANCE          // Company finance: invoices, payments, financial reports
  ROLE_USER             // Standard company user: quotes, shipments, tracking, own invoices
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum ShipmentStatus {
  PENDING
  BOOKED
  AWAITING_PICKUP
  CONFIRMED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
  RETURNED
  PENDING_ADMIN_REVIEW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentChannel {
  CARD
  BANK_TRANSFER
  USSD
  MOBILE_MONEY
  QR
}

enum WeightUnit {
  KG
  TONS
  CARTONS
}

enum NotificationType {
  SHIPMENT_UPDATE
  PAYMENT
  PROMO
  SYSTEM
  DELAY_ALERT
  PRICE_ADJUSTMENT
}

enum ServiceType {
  EXPRESS
  STANDARD
  ECONOMY
}


enum QuoteStatus {
  GENERATED
  EXPIRED
  BOOKED
  CANCELLED
}

enum ConsentType {
  TERMS_OF_SERVICE
  REFUND_POLICY
  SHIPPING_RULES
  INSURANCE_TERMS
  UNINSURED_ACK        // V1 Feature 7 — user acknowledged shipping without insurance
  ON_BEHALF_AUTHORITY  // V1 Feature 3 — user confirmed authority to ship on someone else's behalf
}

// ─── V1 LAUNCH SCOPE ENUMS ──────────────────────────────────────────────────
// V1 Feature 1 — Mode of shipment. Each mode has its own rates, transit time
// and volumetric divisor (see ShipmentModeSetting / PriceBand.shipmentMode).
enum ShipmentMode {
  AIR
  LAND
  SEA
}

// V1 Feature 3 — who the sender of record is.
enum SenderType {
  MYSELF
  ON_BEHALF_OF
}

// V1 Feature 3 — relationship of the account holder to the principal when
// booking ON_BEHALF_OF.
enum PrincipalRelationship {
  CUSTOMER
  MERCHANT
  EMPLOYER
  OTHER
}

// V1 Features 5/6 — how an adhoc charge type's amount is computed.
enum AdhocCalcMethod {
  FIXED
  PER_KG
  PERCENTAGE
}

// V1 Feature 6 — the measurement an adhoc suggestion rule compares against
// its threshold.
enum AdhocRuleMetric {
  ACTUAL_WEIGHT
  VOLUMETRIC_WEIGHT
  BILLABLE_WEIGHT
  VOLUME_CM3
  LONGEST_SIDE
}

// V1 Feature 6 — comparison operator for a rule's threshold(s).
// BETWEEN uses both thresholdMin and thresholdMax (inclusive).
enum AdhocRuleOperator {
  GT
  GTE
  LT
  LTE
  BETWEEN
}

// V1 Feature 6 — whether a matching rule adds its charge automatically or
// only suggests it for admin review.
enum AdhocChargeBehaviour {
  AUTO_APPLY
  SUGGEST
}

// V1 Features 5/6 — lifecycle of one adhoc charge line attached to a quote
// or shipment.
enum AdhocChargeStatus {
  APPLIED                     // AUTO_APPLY rule matched, or admin added manually
  SUGGESTED                   // SUGGEST rule matched, awaiting admin decision
  APPROVED                    // admin approved a SUGGESTED charge (or a post-booking increase)
  DISMISSED                   // admin dismissed a SUGGESTED charge
  PENDING_CUSTOMER_APPROVAL   // post-booking increase awaiting the customer (Sprint 8 price-shock flow)
  REJECTED                    // customer rejected / it timed out and was reversed
}

// V1 Feature 8 — shipment draft lifecycle (review-before-create flow).
enum DraftStatus {
  DRAFT
  CONFIRMED
  EXPIRED
}

enum SurchargeType {
  FUEL
  REMOTE_AREA
  VAT
  FRAGILE
  INSURANCE
  OVERSIZE
}

enum AddressChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ESCALATED
}

enum TicketCategory {
  TRACKING
  PAYMENT
  PRICING_DISPUTE
  DAMAGED_GOODS
  DELIVERY_ISSUE
  ACCOUNT
  OTHER
}

enum FaqCategory {
  PRICING
  SHIPPING_RULES
  TRACKING
  PAYMENTS
  ACCOUNT
  PACKAGING
  CLAIMS
  OTHER
}

// ─── USER ────────────────────────────────────────────────────────────────────

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  phone            String?       @unique
  firstName        String
  lastName         String
  avatar           String?
  avatarPublicId   String?
  role             UserRole      @default(CUSTOMER)
  adminSubRole     AdminSubRole?     // set ONLY when role = ADMIN
  enterpriseRole   EnterpriseRole?  // set ONLY when role = ENTERPRISE
  authProvider     AuthProvider  @default(EMAIL)
  googleId         String?       @unique
  appleId          String?       @unique
  passwordHash     String?
  isEmailVerified  Boolean       @default(false)
  isPhoneVerified  Boolean       @default(false)
  isActive         Boolean       @default(true)
  fcmToken         String?
  twoFactorEnabled Boolean @default(false)
  twoFactorMethod  String? // "EMAIL" | "SMS"

  // ─── Company Info (Settings → Company Info tab) ──────────────────────────
  companyName      String?
  industry         String?
  companyEmail     String?
  companyPhone     String?
  companyWebsite   String?
  companyStreet    String?
  companyCity      String?
  companyState     String?
  companyCountry   String?
  companyZip       String?

  // ─── Enterprise org membership (Sprint 8 team feature) ───────────────────
  // Set when a team member accepts an org invite. Points to the ENTERPRISE
  // user with enterpriseRole = ROLE_MASTER who owns the org. Used to scope
  // shipments, invoices, etc. to the tenant. Only meaningful when
  // role = ENTERPRISE.
  masterId         String?   // FK → User.id of the ROLE_MASTER who owns the org

  addresses           Address[]
  savedCards          SavedCard[]
  shipments           Shipment[]           @relation("CustomerShipments")
  managedShipments    Shipment[]           @relation("AssignedShipments")
  otpCodes            OtpCode[]
  refreshTokens       RefreshToken[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  activityLogs        ActivityLog[]
  payments            Payment[]
  addressChangeReqs   AddressChangeRequest[]
  claims              Claim[]
  supportTickets      SupportTicket[]      @relation("TicketCustomer")
  assignedTickets     SupportTicket[]      @relation("TicketAgent")
  rolePermission      AdminRolePermission? @relation("UserRolePermission")
  createdRolePerms    AdminRolePermission[] @relation("RolePermissionCreator")
  quotes              Quote[]              @relation("UserQuotes")
  consentLogs         ConsentLog[]         @relation("UserConsents")
  priceAuditLogs      PriceAuditLog[]
  contractRates      ContractRate[]
  promoRedemptions   PromoRedemption[]
  loyaltyAccount     LoyaltyAccount?   @relation("UserLoyalty")
  shipmentDrafts     ShipmentDraft[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("users")
}

model Address {
  id          String    @id @default(uuid())
  userId      String
  label       String?
  street      String
  city        String
  state       String
  lga         String?
  postalCode  String?
  country     String    @default("Nigeria")
  lat         Float?
  lng         Float?
  isDefault   Boolean   @default(false)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("addresses")
}

// ─── AUTH ─────────────────────────────────────────────────────────────────────

model OtpCode {
  id        String    @id @default(uuid())
  userId    String
  code      String
  type      String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())

  @@map("otp_codes")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceInfo String?
  ipAddress  String?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())

  @@map("refresh_tokens")
}

// ─── PRICING ─────────────────────────────────────────────────────────────────

model City {
  id        String    @id @default(uuid())
  name      String    @unique
  region    String
  state     String

  fromZones ZoneMatrix[] @relation("FromCity")
  toZones   ZoneMatrix[] @relation("ToCity")
  fromKm    KmMatrix[]   @relation("FromCityKm")
  toKm      KmMatrix[]   @relation("ToCityKm")
  shipmentsFrom Shipment[] @relation("ShipmentFromCity")
  shipmentsTo   Shipment[] @relation("ShipmentToCity")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("cities")
}

model BoxDimension {
  id              String    @id @default(uuid())
  categoryId      String    @unique
  displayName     String
  lengthCm        Float
  widthCm         Float
  heightCm        Float
  bestFor         String?
  weightKgLimit   Float

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("box_dimensions")
}

model ZoneMatrix {
  id          String    @id @default(uuid())
  fromCityId  String
  toCityId    String
  zone        Int
  isActive    Boolean   @default(true)

  fromCity    City      @relation("FromCity", fields: [fromCityId], references: [id])
  toCity      City      @relation("ToCity", fields: [toCityId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([fromCityId, toCityId])
  @@map("zone_matrix")
}

model KmMatrix {
  id          String    @id @default(uuid())
  fromCityId  String
  toCityId    String
  distanceKm  Float

  fromCity    City      @relation("FromCityKm", fields: [fromCityId], references: [id])
  toCity      City      @relation("ToCityKm", fields: [toCityId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([fromCityId, toCityId])
  @@map("km_matrix")
}

model PriceBand {
  id                     String      @id @default(uuid())
  label                  String?
  // Pricing mode A: single zone (legacy / granular)
  zone                   Int?
  pricePerKg             Float?
  basePrice              Float?
  // Pricing mode B: fixed price map across all zones (e.g. {"1":150,"2":200,"3":300,"4":400})
  fixedPricePerKgByZone  Json?
  // Weight / volume range
  minKg                  Float       @default(0)
  maxKg                  Float?
  minTons                Float       @default(0)
  maxTons                Float?
  minCartons             Int         @default(0)
  maxCartons             Int?
  // Discount (optional — mutually exclusive with fixed price fields)
  discountPercent        Float?
  serviceType            ServiceType @default(STANDARD)
  // Mode of shipment this band applies to. Together with serviceType this
  // identifies the ServiceOffering the rate belongs to. Legacy rows were
  // defaulted to LAND (the only mode in practice pre-V1). Rate lookup filters
  // on zone + shipmentMode + serviceType + weight band + validity window and
  // NEVER falls back to a different mode or service (see pricing/rateResolver).
  shipmentMode           ShipmentMode @default(LAND)
  validFrom              DateTime?
  validUntil             DateTime?
  notes                  String?
  isActive               Boolean     @default(true)
  createdBy              String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([zone, shipmentMode, serviceType])
  @@map("price_bands")
}

// ─── V1 Feature 1: per-mode settings (volumetric divisor, transit time) ─────
// One row per ShipmentMode. Seeded with the pre-V1 default divisor (5000)
// for all three modes so nothing changes until admin tunes them.
model ShipmentModeSetting {
  id                  String        @id @default(uuid())
  mode                ShipmentMode  @unique
  volumetricDivisor   Int           @default(5000)
  // DEPRECATED — not a delivery promise. The customer-facing SLA lives on
  // DeliverySLA (zone + shipmentMode + serviceType). Kept only so historical
  // rows stay readable; the quote engine never reads it.
  transitHoursDefault Int?
  isActive            Boolean       @default(true)
  // Physical / operational characteristics of the mode itself. Null = no limit.
  maxWeightKg         Float?
  maxLongestSideCm    Float?
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipment_mode_settings")
}

// ─── V1 Features 5/6: Adhoc charges ──────────────────────────────────────────
// Admin-defined extra charge types (oversize handling, storage, weekend
// pickup, etc). Never hard-deleted — deactivate instead. Every create/update/
// deactivate writes an entry to PriceAuditLog with entityType
// "AdhocChargeType" (same immutable audit pattern used for PriceBand rates).
model AdhocChargeType {
  id                String          @id @default(uuid())
  name              String
  description       String?
  calcMethod        AdhocCalcMethod
  // Kobo for FIXED/PER_KG; whole-number percent (e.g. 5 = 5%) for PERCENTAGE.
  amountKobo        Int?
  percentage        Float?
  vatApplicable     Boolean         @default(true)
  // e.g. ["AIR","SEA"] or [] / null to apply to every mode.
  applicableModes   ShipmentMode[]
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  isActive          Boolean         @default(true)
  version           Int             @default(1)
  createdBy         String?

  rules             AdhocChargeRule[]
  shipmentCharges   ShipmentAdhocCharge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("adhoc_charge_types")
}

// ─── V1 Feature 6: Suggestion/auto-apply rules ───────────────────────────────
// Compares a parcel's weight/volume metric against a threshold; on match,
// links to one AdhocChargeType and either applies it automatically or drops
// it into the admin suggestion queue. Same audit pattern as AdhocChargeType,
// entityType "AdhocChargeRule".
model AdhocChargeRule {
  id              String                @id @default(uuid())
  name            String
  metric          AdhocRuleMetric
  operator        AdhocRuleOperator
  // For GT/GTE/LT/LTE only thresholdMin is used. BETWEEN uses both
  // (inclusive), matching the PRD's operator list (>, >=, <, <=, BETWEEN).
  thresholdMin    Float
  thresholdMax    Float?
  chargeTypeId    String
  chargeType      AdhocChargeType       @relation(fields: [chargeTypeId], references: [id])
  behaviour       AdhocChargeBehaviour  @default(SUGGEST)
  applicableModes ShipmentMode[]
  priority        Int                   @default(0)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  isActive        Boolean               @default(true)
  version         Int                   @default(1)
  createdBy       String?

  matchedCharges  ShipmentAdhocCharge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("adhoc_charge_rules")
}

// ─── V1 Features 5/6: one adhoc charge line attached to a quote or shipment ─
// A snapshot — name/amount are copied at the moment the charge is applied so
// later edits to the charge type never retroactively change what a customer
// was already quoted or billed.
model ShipmentAdhocCharge {
  id             String            @id @default(uuid())
  quoteId        String?
  quote          Quote?            @relation(fields: [quoteId], references: [id])
  shipmentId     String?
  shipment       Shipment?         @relation(fields: [shipmentId], references: [id])
  chargeTypeId   String
  chargeType     AdhocChargeType   @relation(fields: [chargeTypeId], references: [id])
  ruleId         String?           // null = added manually by admin, not rule-triggered
  rule           AdhocChargeRule?  @relation(fields: [ruleId], references: [id])
  // Snapshot at time of application — never mutated after creation.
  nameSnapshot   String
  reason         String?           // e.g. "Billable weight 32kg is above the 30kg threshold"
  amountKobo     Int
  vatKobo        Int               @default(0)
  status         AdhocChargeStatus @default(APPLIED)
  decidedByUserId String?
  decisionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipment_adhoc_charges")
}

// ─── V1 Feature 7: Insurance risk disclaimer ─────────────────────────────────
// Versioned, admin-editable wording + liability limit. Existing consent-log
// entries keep the version the user actually saw, even after a new version
// is published.
model InsuranceDisclaimer {
  id                 String    @id @default(uuid())
  version            String    @unique
  body               String
  liabilityLimitKobo Int
  effectiveFrom      DateTime  @default(now())
  createdByUserId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("insurance_disclaimers")
}

// ─── V1 Feature 8: Shipment draft (review-before-create booking flow) ───────
// Nothing is a real Shipment until CONFIRMED. DRAFT while being edited on the
// review screen, EXPIRED 24h after creation if never confirmed (kept for
// audit, cannot be confirmed once expired).
model ShipmentDraft {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  quoteId       String
  quote         Quote        @relation(fields: [quoteId], references: [id])
  // Everything gathered on the "booking details" step — sender/recipient,
  // sender type + principal, alternative numbers, pickup date, notes, etc.
  // Kept as JSON since the review screen can PATCH any subset of it without
  // a schema change per new field.
  details       Json
  status        DraftStatus  @default(DRAFT)
  idempotencyKey String?     @unique
  shipmentId    String?      @unique
  shipment      Shipment?    @relation(fields: [shipmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipment_drafts")
}

model Surcharge {
  id          String        @id @default(uuid())
  type        SurchargeType
  label       String
  description String?
  ratePercent Float?
  flatAmount  Float?
  isActive    Boolean       @default(true)
  appliesTo   String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("surcharges")
}

model PriceAuditLog {
  id            String    @id @default(uuid())
  entityType    String
  entityId      String
  action        String
  previousValue Json?
  newValue      Json?
  changedBy     String
  reason        String?

  user          User      @relation(fields: [changedBy], references: [id])

  createdAt     DateTime  @default(now())

  @@map("price_audit_logs")
}

// ─── SHIPMENT ─────────────────────────────────────────────────────────────────

model Shipment {
  id               String         @id @default(uuid())
  trackingNumber   String         @unique
  customerId       String
  assignedToId     String?

  senderName       String
  senderPhone      String
  senderAddress    String
  senderCity       String
  senderState      String

  recipientName    String
  recipientPhone   String
  recipientAddress String
  recipientCity    String
  recipientState   String

  description      String?
  weight           Float
  weightUnit       WeightUnit      @default(KG)
  cartons          Int?
  boxDimensionId   String?
  customLength     Float?
  customWidth      Float?
  customHeight     Float?

  serviceType      ServiceType     @default(STANDARD)
  fromCityId       String?
  toCityId         String?
  fromCity         City?           @relation("ShipmentFromCity", fields: [fromCityId], references: [id])
  toCity           City?           @relation("ShipmentToCity",   fields: [toCityId],   references: [id])
  zone             Int?
  distanceKm       Float?
  quotedPrice      Float
  finalPrice       Float?
  currency         String          @default("NGN")
  surchargeBreakdown Json?

  status           ShipmentStatus  @default(PENDING)
  paymentStatus    PaymentStatus   @default(PENDING)
  cutoffWarning    Boolean         @default(false)

  pickupDate        DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?

  isFragile        Boolean         @default(false)
  requiresInsurance Boolean        @default(false)
  insuranceValue   Float?
  notes            String?

  // ── V1 launch scope additions ─────────────────────────────────────────
  // Feature 1: mode of shipment, copied from the quote at booking time.
  shipmentMode          ShipmentMode?
  // Locked commercial snapshot copied from the quote at booking time.
  offeringId            String?
  slaMinDays            Int?
  slaMaxDays            Int?
  pricingSnapshot       Json?
  // Feature 2: value of items being sent — always captured, insured or not.
  declaredValueKobo     Int?
  insuranceSelected     Boolean       @default(false)
  // Feature 7: when the uninsured-risk disclaimer was acknowledged (null
  // while insured, or before the review-screen tick is recorded).
  uninsuredAckAt        DateTime?
  // Feature 3: who the sender of record is, and — for ON_BEHALF_OF — the
  // real owner of the goods. The account holder (`customer` below) always
  // stays the billing party regardless of sender type.
  senderType            SenderType    @default(MYSELF)
  principalName         String?
  principalPhone        String?
  principalEmail        String?
  principalRelationship PrincipalRelationship?
  authorityConfirmed    Boolean       @default(false)
  // Feature 4: backup contact numbers. senderAltPhone is optional (and for
  // ON_BEHALF_OF belongs to the principal); recipientAltPhone is required
  // at booking. Both are masked on the guest tracking page.
  senderAltPhone        String?
  recipientAltPhone     String?

  customer         User            @relation("CustomerShipments", fields: [customerId], references: [id])
  assignedTo       User?           @relation("AssignedShipments", fields: [assignedToId], references: [id])
  trackingHistory  TrackingEvent[]
  documents        ShipmentDocument[]
  payments         Payment[]
  addressChangeReqs AddressChangeRequest[]
  claims           Claim[]
  priceAdjustments PriceAdjustment[]
  quote            Quote?
  adhocCharges     ShipmentAdhocCharge[]
  draft            ShipmentDraft?
  // FIX: SupportTicket.shipmentId had no relation back to Shipment, so
  // admin/customer ticket views could never resolve a tracking number —
  // they only ever had the raw shipmentId. Added so listTickets/getTicket
  // can `include: { shipment: { select: { trackingNumber: true } } }`.
  supportTickets   SupportTicket[]
  delayAlert       DelayAlert?

  pickupLat           Float?
  pickupLng           Float?
  proximityAlertSent  Boolean  @default(false)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("shipments")
}

model TrackingEvent {
  id          String    @id @default(uuid())
  shipmentId  String
  status      ShipmentStatus
  location    String?
  description String
  lat         Float?
  lng         Float?
  updatedBy   String?
  proofUrl    String?

  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@map("tracking_events")
}

model ShipmentDocument {
  id           String   @id @default(uuid())
  shipmentId   String
  type         String
  url          String
  publicId     String
  uploadedBy   String?

  shipment     Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@map("shipment_documents")
}

model AddressChangeRequest {
  id                  String              @id @default(uuid())
  shipmentId          String
  userId              String
  newRecipientAddress String
  newRecipientCity    String
  newRecipientState   String
  reason              String?
  status              AddressChangeStatus @default(PENDING)
  reviewedBy          String?
  reviewedAt          DateTime?
  reviewNote          String?

  shipment            Shipment            @relation(fields: [shipmentId], references: [id])
  user                User                @relation(fields: [userId], references: [id])

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("address_change_requests")
}

model PriceAdjustment {
  id              String    @id @default(uuid())
  shipmentId      String
  originalPrice   Float
  adjustedPrice   Float
  difference      Float
  reason          String
  actualWeightKg  Float?
  // Legacy single image — kept for backward compatibility
  proofImageUrl   String?
  // Multi-image support (up to 5 URLs stored as JSON array)
  proofImageUrls  Json?
  isAcknowledged  Boolean   @default(false)
  acknowledgedAt  DateTime?
  isPaid          Boolean   @default(false)
  paymentRef      String?

  // ── Resolution workflow (PRD: Post-Booking Price Shock Prevention) ─────────
  // status: PENDING | PAID | DOWNGRADED | CANCELLED | EXPIRED
  status          String    @default("PENDING")
  // Shipment status captured at the moment it was paused, so we know what
  // to resume it to once resolved (rather than guessing).
  previousStatus  String?
  // Deadline for the customer to respond. Configurable via AppSettings
  // (price_adjustment.response_window_hours). Past this, the scheduler
  // auto-cancels with a refund.
  responseDeadline DateTime?
  resolvedAt      DateTime?
  // resolutionType: PAY | DOWNGRADE | CANCEL | AUTO_CANCEL
  resolutionType  String?
  refundPercent   Int?
  refundAmount    Float?
  // Support/admin override of the deadline
  extendedBy      String?
  extensionNote   String?
  // [V1 Feature 6] IDs of ShipmentAdhocCharge rows this adjustment covers,
  // when the price shock came from adhoc rules re-run at weigh-in rather
  // than (or in addition to) a plain weight discrepancy. Null for
  // weight-only adjustments, preserving pre-V1 behaviour exactly.
  adhocChargeIds  Json?

  shipment        Shipment  @relation(fields: [shipmentId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("price_adjustments")
}

model Claim {
  id              String      @id @default(uuid())
  shipmentId      String
  userId          String
  type            String
  description     String
  declaredValue   Float
  claimAmount     Float
  bankName        String?
  accountNumber   String?
  accountName     String?
  status          ClaimStatus @default(SUBMITTED)
  reviewNote      String?
