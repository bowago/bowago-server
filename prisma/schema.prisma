// ─── DELIVERY SLA ─────────────────────────────────────────────────────────────
// Admin-configurable delivery promise per zone × shipment mode × service type.
// Zone 1 = same state (closest), Zone 4 = furthest cross-region.
// The delivery promise depends on HOW freight moves (mode) as well as on the
// service commitment, so mode is part of the key. Legacy rows (which had no
// mode) were migrated to LAND — the only mode operated before the offering
// model existed. See prisma/migrate-offering-model.js.
model DeliverySLA {
  id           String       @id @default(uuid())
  zone         Int
  shipmentMode ShipmentMode @default(LAND)
  serviceType  String       // EXPRESS | STANDARD | ECONOMY
  minDays      Int
  maxDays      Int
  label        String?      // auto-generated: "1-3 business days"
  createdBy    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([zone, shipmentMode, serviceType])
  @@map("delivery_sla")
}

// ─── Shipping offering ──────────────────────────────────────────────────────
// A real, purchasable shipping product: shipment mode + service type, with the
// eligibility rules that govern it. An offering is only SELLABLE for a given
// request when, in addition, the lane is open, a DeliverySLA exists for
// (zone, mode, service) and a usable PriceBand exists for the billable weight.
// Combinations without an offering row (e.g. SEA + EXPRESS) simply do not
// exist — nothing fabricates them.
model ServiceOffering {
  id               String       @id @default(uuid())
  shipmentMode     ShipmentMode
  serviceType      ServiceType
  displayName      String?      // presentation label, e.g. "Air Express"
  description      String?
  isActive         Boolean      @default(true)
  // Set true ONLY when the product explicitly permits selling without a
  // delivery promise. Default false: no SLA => not sellable.
  allowsNoSla      Boolean      @default(false)
  // Eligibility (null = no limit). Mode-level limits live on ShipmentModeSetting.
  minWeightKg      Float?
  maxWeightKg      Float?
  maxLongestSideCm Float?
  // Minimum chargeable base price in NGN (applied to the standard base price).
  minChargeNaira   Float?
  sortOrder        Int          @default(0)
  notes            String?
  createdBy        String?

  lanes            OfferingLane[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shipmentMode, serviceType])
  @@map("service_offerings")
}

// Route/lane availability override for one offering. Resolution: exact city
// pair beats zone; a lane with no matching rule is available (subject to the
// SLA and rate requirements). isAvailable=false blocks the lane.
model OfferingLane {
  id          String          @id @default(uuid())
  offeringId  String
  offering    ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  fromCityId  String?
  toCityId    String?
  zone        Int?
  isAvailable Boolean         @default(true)
  reason      String?
  createdBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([offeringId])
  @@map("offering_lanes")
}

