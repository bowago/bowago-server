// ─── CUSTOM ADMIN ROLE PERMISSIONS (Sprint 2) ─────────────────────────────────
// SUPER_ADMIN creates custom admin roles with specific capability flags.
// One record per admin user — defines their capabilities.
model AdminRolePermission {
  id               String   @id @default(uuid())
  userId           String   @unique
  // Capability flags — SUPER_ADMIN toggles these per staff member
  canManageRates          Boolean @default(false)
  canManageUsers          Boolean @default(false)
  canManageShipments      Boolean @default(false)
  canViewAnalytics        Boolean @default(false)
  canManageTickets        Boolean @default(false)
  canManageInvoices       Boolean @default(false)
  canManageSurcharges     Boolean @default(false)
  canManagePromos         Boolean @default(false)
  canManageClaims         Boolean @default(false)
  canBulkNotify           Boolean @default(false)
  canViewAuditLogs        Boolean @default(false)
  canManageOrganization   Boolean @default(false)
  // [V1] Manage adhoc charge types, suggestion rules, and the suggestion
  // approval queue (admin_role_permissions.adhoc_charges:READ/CREATE/UPDATE
  // in the PRD — modeled as a single capability flag, consistent with every
  // other capability on this table).
  canManageAdhocCharges   Boolean @default(false)
  // Role label (e.g. "Rate Manager", "CS Lead")
  roleLabel        String?
  notes            String?
  createdBy        String
  updatedBy        String?

  user             User     @relation("UserRolePermission", fields: [userId], references: [id])
  creator          User     @relation("RolePermissionCreator", fields: [createdBy], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("admin_role_permissions")
}

// ─── QUOTE LIFECYCLE (Sprint 1 gap fix) ──────────────────────────────────────
// Quotes are valid for exactly 15 minutes. Immutable once locked.
model Quote {
  id                    String      @id @default(uuid())
  userId                String?     // null = guest quote
  status                QuoteStatus @default(GENERATED)
  // Origin / Destination
  originCity            String
  originCityId          String?
  destinationCity       String
  destinationCityId     String?
  zone                  Int?
  distanceKm            Float?
  // Weight
  weightKg              Float?
  volumetricWeightKg    Float?
  billableWeightKg      Float?
  lengthCm              Float?
  widthCm               Float?
  heightCm              Float?
  // Pricing
  serviceType           ServiceType @default(STANDARD)
  // [V1 Feature 1] Mode of shipment (AIR/LAND/SEA). Nullable so quotes
  // generated before V1 shipped remain readable without a backfill; every
  // quote created going forward through the V1 flow always sets this.
  shipmentMode          ShipmentMode?
  // Identity of the shipping product priced by this quote (ServiceOffering.id)
  // and the rate row that produced the base price. Null only on legacy quotes.
  offeringId            String?
  priceBandId           String?
  // Delivery promise snapshot — the SLA the customer saw. Shipment creation
  // uses THIS, never today's DeliverySLA row.
  slaMinDays            Int?
  slaMaxDays            Int?
  slaLabel              String?
  // Explicit pricing components (kobo). basePriceKobo is the FINAL base after
  // contract/promo; standardBasePriceKobo is the rate-card price before it.
  standardBasePriceKobo Int?
  // Sum of real surcharges only (fuel, remote area, fragile...) — excludes
  // ad-hoc charges, VAT and insurance, which have their own columns.
  surchargeTotalKobo    Int?
  // Full authoritative calculation as shown to the customer. Never recomputed.
  pricingSnapshot       Json?
  basePriceKobo         Int         // stored in kobo to avoid float errors
  fuelSurchargeKobo     Int         @default(0)
  remoteAreaFeeKobo     Int         @default(0)
  // [V1 Features 5/6] Sum of all adhoc charge lines attached to this quote
  // (see ShipmentAdhocCharge). Included in vatKobo/totalPriceKobo the same
  // way fuel/remote-area fees are — see the updated price formula.
  adhocChargesKobo      Int         @default(0)
  vatKobo               Int         @default(0)
  totalPriceKobo        Int
  surchargeBreakdown    Json?
  // Insurance
  insuranceSelected     Boolean     @default(false)
  // [V1 Feature 2] Always required going forward, whether or not insurance
  // is selected — kept nullable at the DB level only for pre-V1 rows.
  declaredValueKobo     Int?
  insurancePremiumKobo  Int?
  adhocCharges          ShipmentAdhocCharge[]
  drafts                ShipmentDraft[]
  // Pricing mode — records which rate path was used at quote time (Gap 6)
  pricingMode           String    @default("STANDARD") // STANDARD | CONTRACT | PROMO
  // Promo
  promoCode             String?
  promoDiscountKobo     Int?
  // Lifecycle timestamps
  expiresAt             DateTime    // createdAt + 15 min
  bookedAt              DateTime?
  cancelledAt           DateTime?
  // Linked shipment (once booked)
  shipmentId            String?     @unique
  shipment              Shipment?   @relation(fields: [shipmentId], references: [id])

  user                  User?       @relation("UserQuotes", fields: [userId], references: [id])

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("quotes")
}

// ─── CONSENT LOG (Sprint 7) ───────────────────────────────────────────────────
// Immutable audit of user consent at quote/payment/booking time.
model ConsentLog {
  id            String      @id @default(uuid())
  userId        String?
  sessionId     String?     // for guest consent
  consentType   ConsentType
  tcVersion     String      // e.g. "v1.2" — also used for disclaimer version on UNINSURED_ACK
  acceptedAt    DateTime    @default(now())
  ipAddress     String?
  userAgent     String?
  // [V1] Quote or shipment id this consent was captured against (e.g. which
  // quote's declared value the UNINSURED_ACK notice showed, or which
  // shipment's ON_BEHALF_AUTHORITY tick this is). Null for the older
  // account-wide consent types (TERMS_OF_SERVICE etc.) which aren't tied to
  // one quote/shipment.
  referenceId   String?
  // [V1] Extra context the immutable log needs to keep, e.g. for
  // UNINSURED_ACK: { declaredValueKobo, liabilityLimitKobo }.
  metadata      Json?

  user          User?       @relation("UserConsents", fields: [userId], references: [id])

  @@map("consent_logs")
}

model FailedWebhook {
        id            String    @id @default(uuid())
        event         String    // e.g. "charge.success"
        payload       Json      // full original webhook body, for replay
        errorMessage  String?
        attempts      Int       @default(0)
        status        String    @default("FAILED") // FAILED | RESOLVED | IGNORED
        createdAt     DateTime  @default(now())
        lastRetriedAt DateTime?
        resolvedAt    DateTime?

        @@index([status])
        @@index([event])
      }


// ─── LOGIN LOCKOUT (Sprint 2 gap fix) ────────────────────────────────────────
// Track failed login attempts per email for 15-minute lockout after 5 failures.
model LoginAttempt {
  id            String   @id @default(uuid())
  email         String
  failedCount   Int      @default(0)
  lockedUntil   DateTime?
  lastAttemptAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([email])
  @@map("login_attempts")
}

// ─── ORG INVITE (Sprint 8) ────────────────────────────────────────────────────
// Master user invites team members via email. Invite expires in 7 days.
model OrgInvite {
  id          String    @id @default(uuid())
  email       String
  role        String    @default("ROLE_DISPATCHER") // EnterpriseRole string
  invitedBy   String    // User.id of master who sent invite
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  status      String    @default("PENDING") // PENDING | ACCEPTED | EXPIRED | CANCELLED

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  emailSent   Boolean   @default(false)
  emailError  String?

  @@index([email])
  @@index([status])
  @@map("org_invites")
}

// ─── LOYALTY & REWARDS (Customer Portal) ─────────────────────────────────────
// Points are earned on paid delivery and redeemed at checkout.
// Tier is recalculated each time points are earned.
//
// Tier thresholds (configurable via AppSettings):
//   BRONZE  0–499 pts   → no multiplier
//   SILVER  500–1999    → 1.25×
//   GOLD    2000–4999   → 1.5×
//   PLATINUM 5000+      → 2×
//
// Earn rate: 1 point per ₦100 of shipment final price (configurable).
// Redeem rate: 1 point = ₦1 discount, min 50 pts per redemption (configurable).

model LoyaltyAccount {
  id              String    @id @default(uuid())
  userId          String    @unique
  points          Int       @default(0)    // current spendable balance
  lifetimePoints  Int       @default(0)    // never decremented — used for tier
  tier            String    @default("BRONZE") // BRONZE | SILVER | GOLD | PLATINUM

  user            User      @relation("UserLoyalty", fields: [userId], references: [id])
  transactions    LoyaltyTransaction[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id          String   @id @default(uuid())
  accountId   String
  type        String   // EARN | REDEEM | ADJUST | EXPIRE
  points      Int      // positive = earn, negative = redeem/expire
  description String
  shipmentId  String?  // source shipment for EARN or REDEEM

  account     LoyaltyAccount @relation(fields: [accountId], references: [id])

  createdAt   DateTime @default(now())
  @@map("loyalty_transactions")
}

// ─── DELAY ALERTS (SLA Breach Detection) ─────────────────────────────────────
// Written by the SLA breach scheduler when a shipment overruns its estimated
// delivery date. Used to avoid spamming the same customer on every sweep.

model DelayAlert {
  id          String   @id @default(uuid())
  shipmentId  String
  alertedAt   DateTime @default(now())
  reason      String?

  shipment    Shipment @relation(fields: [shipmentId], references: [id])

  @@unique([shipmentId])  // one active alert per shipment
  @@map("delay_alerts")
}
