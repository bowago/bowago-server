// Contract / negotiated pricing. Scope is explicit:
//   shipmentMode = null  -> applies to ALL modes (only valid for percent discounts)
//   shipmentMode = X     -> applies to that mode only
//   serviceType  = null  -> applies to ALL services, else that service only
// A fixed per-kg card (fixedPricePerKgByZone) MUST name a mode, because an
// absolute NGN/kg figure is meaningless across air/land/sea.
// A user may hold several contracts (e.g. one per mode); scopes of active,
// overlapping-validity contracts may not overlap (enforced server-side).
model ContractRate {
  id                     String      @id @default(uuid())
  userId                 String
  label                  String?
  shipmentMode           ShipmentMode?
  serviceType            ServiceType?
  discountPercent        Float?
  fixedPricePerKgByZone  Json?
  isActive               Boolean     @default(true)
  validFrom              DateTime?
  validUntil             DateTime?
  notes                  String?
  createdBy              String?
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([userId, isActive])
  @@map("contract_rates")
}

// Sprint 2 — Promo Codes (customer-facing codes e.g. LAUNCH20)
model PromoCode {
  id              String    @id @default(uuid())
  code            String    @unique
  description     String?
  discountPercent Float?
  flatDiscount    Float?
  minOrderAmount  Float?
  maxUses         Int?
  usedCount       Int       @default(0)
  isActive        Boolean   @default(true)
  validFrom       DateTime?
  validUntil      DateTime?
  // null = all services / all modes (explicit "applies to everything").
  serviceType     ServiceType?
  shipmentMode    ShipmentMode?
  createdBy       String?
  redemptions     PromoRedemption[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("promo_codes")
}

model PromoRedemption {
  id              String    @id @default(uuid())
  promoCodeId     String
  userId          String
  shipmentId      String?
  discountApplied Float
  promoCode       PromoCode @relation(fields: [promoCodeId], references: [id])
  user            User      @relation(fields: [userId], references: [id])
  createdAt       DateTime  @default(now())

  @@unique([promoCodeId, userId, shipmentId])
  @@map("promo_redemptions")
}

